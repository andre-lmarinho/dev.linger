
pkgname=devlinger
pkgver=@VERSION@
pkgrel=1
pkgdesc='Monitor and stop local development services from the Linux system tray'
arch=('x86_64')
url='@REPO_URL@'
license=('MIT')
makedepends=('go')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "${srcdir}/dev.linger-${pkgver}"

  export GOPATH="${srcdir}/gopath"
  CGO_ENABLED=0 go build -trimpath \
    -ldflags='-s -w' \
    -o devlinger .
}

package() {
  cd "${srcdir}/dev.linger-${pkgver}"

  ./scripts/expand-assets.sh --autostart "${pkgdir}"

  install -Dm755 devlinger \
    "${pkgdir}/usr/bin/devlinger"

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

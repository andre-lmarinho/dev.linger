<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>DevLinger</name>
  <summary>Monitor and stop local development services from your Linux system tray</summary>

  <description>
    <p>
      DevLinger is a Linux system tray application that monitors and
      gracefully stops local development servers and Docker containers.
    </p>
    <p>
      View project names and ports without keeping your development
      tools open.
    </p>
  </description>

  <developer id="io.github.andre-lmarinho">
    <name>André Marinho</name>
  </developer>

  <launchable type="desktop-id">@APPID@.desktop</launchable>
  <url type="homepage">@REPO_URL@</url>
  <url type="bugtracker">@REPO_URL@/issues</url>

  <releases>
    <release version="0.4.1" date="2026-11-18" />
    <release version="0.4.0" date="2026-11-17" />
    <release version="0.3.2" date="2026-11-08" />
  </releases>

  <content_rating type="oars-1.1" />

  <provides>
    <binary>devlinger</binary>
  </provides>
</component>
